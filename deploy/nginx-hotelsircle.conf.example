# nginx configuration for hotelsircle.com
#
# Mirrors /etc/nginx/sites-available/hotelsircle.com on the production server.
# Nothing reads this file; it lives here so the server-side half of the SEO
# work is reviewable. GET /sitemap.xml in apps/api/src/routes/seo.routes.ts
# does nothing until nginx forwards that path to it.
#
# Ports on this host:
#   127.0.0.1:5111   API  (apps/api, pm2 "hotelsircle-api")
#   127.0.0.1:3001   web  (pm2 "hotelsircle-web")
#
# The frontend is proxied, not served from a docroot — there is no root or
# try_files here.

server {
    listen 443 ssl;
    server_name hotelsircle.com www.hotelsircle.com;

    access_log /var/log/nginx/hotelsircle_access.log;
    error_log /var/log/nginx/hotelsircle_error.log;

    ssl_certificate /etc/letsencrypt/live/hotelsircle.com/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/hotelsircle.com/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

    # ── Sitemap, generated live from the database by the API ───────────────
    #
    # An exact-match location, so this is the only request it affects.
    # Proxied rather than hosted anywhere else because Google only accepts a
    # sitemap served from the same host as the URLs it lists.
    #
    # No external generator can produce this: the site is a client-rendered
    # SPA, so the HTML a crawler downloads is an empty #root div with no links
    # in it. The API builds the file from the data on each request instead, so
    # it never goes stale and nothing has to be regenerated when a member is
    # approved.
    location = /sitemap.xml {
        proxy_pass         http://127.0.0.1:5111/sitemap.xml;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    location /api/ {
        proxy_pass http://localhost:5111/api/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }

    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}

server {
    listen 80;
    server_name hotelsircle.com www.hotelsircle.com;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # This block was generated by Certbot as
    #   if ($host = hostelsircle.com) { return 301 https://$host$request_uri; }
    # — hostel, not hotel. The condition never matched, so it fell through to
    # the block's `return 404` and every plain-http request to the site
    # answered 404 instead of redirecting to https.
    #
    # $host rather than a literal: the visitor stays on whichever hostname
    # they typed. See the note on canonicalisation below for why this must not
    # be changed to force www on its own.
    location / {
        return 301 https://$host$request_uri;
    }
}

# ─── Apply ──────────────────────────────────────────────────────────────────
#   sudo nginx -t                  # never reload without this
#   sudo systemctl reload nginx    # reload, not restart: no dropped connections
#
# ─── Verify ─────────────────────────────────────────────────────────────────
#   curl -sI https://hotelsircle.com/sitemap.xml | head -1      # 200
#   curl -sI http://hotelsircle.com/ | head -2                  # 301 → https
#   curl -s  https://hotelsircle.com/sitemap.xml | grep -c '<url>'
#
# ─── Deliberately NOT applied, and what each one needs first ────────────────
#
# 1. Canonical hostname (non-www → www 301).
#
#    Both hostnames currently serve every page and return 200, so Google sees
#    each page twice and splits its ranking. Worth fixing — but NOT on its own.
#    apps/web/.env pins the frontend to an absolute API host:
#
#        REACT_APP_API_URL=https://hotelsircle.com/api
#
#    Add a host redirect while that is absolute and every API call becomes a
#    cross-origin redirect. Browsers do not follow redirects on cross-origin
#    requests, so the calls fail outright and the site stops loading data.
#    (This is exactly what happened when the redirect was first tried.)
#
#    Order: make the API URL relative (REACT_APP_API_URL=/api), restart the
#    web process, confirm the site works, and only then add the redirect.
#    A relative path is same-origin by construction on any hostname, which
#    removes this whole class of failure permanently.
#
#    Prerequisite: the certificate must cover www —
#        sudo certbot certificates | grep -A3 hotelsircle
#    A cert for the bare domain only gives ERR_CERT_COMMON_NAME_INVALID on www.
#    Expand it without letting certbot rewrite this file:
#        sudo certbot certonly --webroot -w /var/www/certbot --expand \
#          -d hotelsircle.com -d www.hotelsircle.com
#
# 2. id → slug 301 redirects.
#
#    Old profile URLs (/members/<cuid>) still resolve because the API accepts
#    an id or a slug, but they do not redirect, so Google indexes both forms.
#    The block below turns them into real 301s. It routes on shape alone: a
#    cuid matches ^c[a-z0-9]{20,30}$ and a slug (firstname-lastname) always
#    contains a hyphen, which a cuid never does.
#
#    NB the capture is named pcuid, not pid — $pid is a built-in nginx
#    variable (worker process id) and reusing it fails nginx -t with
#    `duplicate "pid" variable`.
#
#    Needs @spa, which in turn depends on how the frontend is served — see 3.
#
#    location ~ "^/(?<ptype>members|experts|advisory)/(?<pcuid>c[a-z0-9]{20,30})/?$" {
#        proxy_pass              http://127.0.0.1:5111/_seo/legacy-profile/$ptype/$pcuid;
#        proxy_http_version      1.1;
#        proxy_set_header        Host              $host;
#        proxy_set_header        X-Real-IP         $remote_addr;
#        proxy_set_header        X-Forwarded-For   $proxy_add_x_forwarded_for;
#        proxy_set_header        X-Forwarded-Proto $scheme;
#        proxy_intercept_errors  on;
#        error_page              404 502 503 504 = @spa;
#    }
#
#    location @spa {
#        proxy_pass         http://127.0.0.1:3001;
#        proxy_http_version 1.1;
#        proxy_set_header   Host              $host;
#        proxy_set_header   X-Real-IP         $remote_addr;
#        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
#        proxy_set_header   X-Forwarded-Proto $scheme;
#    }
#
# 3. The frontend is running the webpack DEV server in production.
#
#    pm2 process "hotelsircle-web" runs `react-scripts start`, so visitors get
#    unminified, unsplit JavaScript with source maps — megabytes per page load
#    instead of a few hundred kilobytes — and `npm run build` output is never
#    served at all. Page speed is a ranking signal, so this works against the
#    rest of the SEO work.
#
#    Replacement:
#        npm run build
#        pm2 delete hotelsircle-web
#        pm2 serve apps/web/build 3001 --spa --name hotelsircle-web
#        pm2 save
#
#    Better still: serve apps/web/build from nginx directly and drop the 3001
#    proxy. @spa above then becomes `root <build dir>; try_files /index.html =404;`
#    and `location /` becomes `try_files $uri $uri/ /index.html`.
