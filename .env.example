# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/hospitality_network?schema=public"

# JWT
JWT_SECRET="your-jwt-secret-key-change-in-production"
JWT_REFRESH_SECRET="your-refresh-secret-key-change-in-production"
JWT_EXPIRES_IN="15m"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# API
API_PORT=5000
NODE_ENV=development

# Frontend
REACT_APP_API_URL=http://localhost:5000/api

# ── Canonical site URL ───────────────────────────────────────────────────────
# These two MUST agree. They are separate because they are read at different
# times:
#
#   SITE_URL            read by the API at runtime. Used for sitemap.xml
#                       entries and for the share links sent by email.
#   REACT_APP_SITE_URL  inlined into the JS bundle by CRA at BUILD time, so it
#                       has to be set before `npm run build`, not just before
#                       the server starts. Used for canonical and og: tags.
#
# If REACT_APP_SITE_URL is missing the app falls back to window.location.origin,
# which is correct in production — so a missing value produces no visible
# symptom until canonical tags start pointing at the wrong host. Set it
# explicitly.
SITE_URL=http://localhost:3000
REACT_APP_SITE_URL=http://localhost:3000

# CORS (comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:3000
